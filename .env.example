FLASK_HOST=127.0.0.1
FLASK_PORT=5000
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=Qwen/Qwen3-0.6B-GGUF:Q8_0
LLAMA_TIMEOUT_SECONDS=90
